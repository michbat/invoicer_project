# ============================================
# Modèle d'environnement - versionnable
# Copier ce fichier vers .env puis adapter :
#   cp .env.example .env
# ============================================

# PostgreSQL (conteneur Docker)
POSTGRES_USER=invoicer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=invoicer

# Connexion Prisma / application depuis la machine hôte (port 5433)
DATABASE_URL="postgresql://invoicer:change-me@localhost:5433/invoicer?schema=public"
